GlacierIsle_House_Text_HermitGift::
    .string "Brr! Shut the door behind you.\p"
    .string "I scrape this powder off the ice\n"
    .string "walls. It glitters like snow\l"
    .string "at noon. Take some.$"

GlacierIsle_House_Text_HermitReceived::
    .string "{PLAYER} received BRIGHTPOWDER!$"

GlacierIsle_House_Text_HermitAfter::
    .string "Foes can't see straight when a\n"
    .string "POKéMON holding BRIGHTPOWDER\l"
    .string "glitters at them. PRYCE swears\l"
    .string "by it in a blizzard.$"

GlacierIsle_House_Text_HermitNoRoom::
    .string "Oh, your BAG is full.\p"
    .string "Make some room and come back.\n"
    .string "It will keep until then.$"

